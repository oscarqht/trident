{
  "name": "trident-git",
  "version": "0.22.0",
  "private": false,
  "description": "A modern, web-based Git client.",
  "repository": {
    "type": "git",
    "url": "https://github.com/oscarqht/trident"
  },
  "bin": {
    "trident-git": "bin/trident-git.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "public",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,API\" -c \"cyan.bold,magenta.bold\" \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "prepack": "rm -rf dist && npm run build",
    "start": "node bin/trident-git.mjs",
    "cli": "node ./bin/trident-git.mjs",
    "pack:preview": "npm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "client",
    "vite",
    "hono"
  ],
  "license": "MIT",
  "dependencies": {
    "@alexbruf/react-diff-viewer": "^3.1.5",
    "@hono/node-server": "^1.13.8",
    "@tanstack/react-query": "^5.90.20",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.18",
    "hono": "^4.7.4",
    "keytar": "^7.9.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.0",
    "simple-git": "^3.30.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "gfport": "^1.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vite": "^6.1.1"
  }
}
